 fs/internal.h              |    2 +-
 fs/namei.c                 |    2 +-
 fs/open.c                  |    2 +-
 security/selinux/hooks.c   |    2 +-
 security/smack/smack_lsm.c |    2 +-
 6 files changed, 9 insertions(+), 9 deletions(-)

