diff -Nur svnRefpolicy/policy/modules/services/xserver.fc svnRefpolicy-local/policy/modules/services/xserver.fc
--- svnRefpolicy/policy/modules/services/xserver.fc	2007-04-16 14:55:36.000000000 +0800
+++ svnRefpolicy-local/policy/modules/services/xserver.fc	2007-05-11 17:28:31.000000000 +0800
@@ -67,6 +67,9 @@
 ifdef(`distro_debian', `
 /usr/sbin/gdm		--	gen_context(system_u:object_r:xdm_exec_t,s0)
 ')
+ifdef(`distro_redhat', `
+/usr/sbin/gdm		--	gen_context(system_u:object_r:xdm_exec_t,s0)
+')
 
 /usr/lib(64)?/qt-.*/etc/settings(/.*)?	gen_context(system_u:object_r:xdm_var_run_t,s0)
 

