fd=open("/tmp/interfaces")
records = fd.readlines()
fd.close()
dict={}
for rec in records:
    r = rec.split("(")[0]
    if r in dict.keys():
        dict[r] =  dict[r] +1
    else:
        dict[r] = 1
        
print dict.values
for k in dict:
    print "%5s %s" % (dict[k], k)
        

